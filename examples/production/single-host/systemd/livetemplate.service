[Unit]
Description=LiveTemplate Production Application
Documentation=https://github.com/livefir/livetemplate
After=network.target

[Service]
Type=simple
User=livetemplate
Group=livetemplate
WorkingDirectory=/opt/livetemplate

# Environment configuration
Environment="PORT=8080"
Environment="ENV=production"
Environment="LVT_LOG_LEVEL=info"
Environment="LVT_DEV_MODE=false"
Environment="LVT_METRICS_ENABLED=true"
Environment="LVT_SHUTDOWN_TIMEOUT=30s"

# Load additional environment variables from file
EnvironmentFile=-/etc/livetemplate/config.env

# Start the application
ExecStart=/opt/livetemplate/app

# Restart policy
Restart=on-failure
RestartSec=5s

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=35s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/livetemplate

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=livetemplate

[Install]
WantedBy=multi-user.target
