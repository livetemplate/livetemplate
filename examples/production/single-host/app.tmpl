<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            padding: 40px;
            max-width: 500px;
            width: 100%;
        }
        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 28px;
        }
        .subtitle {
            color: #666;
            margin-bottom: 30px;
            font-size: 14px;
        }
        .counter-display {
            background: #f7fafc;
            border-radius: 8px;
            padding: 30px;
            text-align: center;
            margin-bottom: 20px;
        }
        .counter-value {
            font-size: 72px;
            font-weight: bold;
            color: #667eea;
            margin-bottom: 10px;
        }
        .counter-label {
            color: #666;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .button-group {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            margin-bottom: 20px;
        }
        button {
            background: #667eea;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 15px 20px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        button:hover {
            background: #5568d3;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }
        button:active {
            transform: translateY(0);
        }
        button.reset {
            grid-column: 1 / -1;
            background: #e53e3e;
        }
        button.reset:hover {
            background: #c53030;
        }
        .footer {
            text-align: center;
            color: #666;
            font-size: 12px;
            padding-top: 20px;
            border-top: 1px solid #e2e8f0;
        }
        .badge {
            display: inline-block;
            background: #48bb78;
            color: white;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 20px;
        }
        .features {
            background: #f7fafc;
            border-radius: 6px;
            padding: 15px;
            margin-bottom: 20px;
        }
        .features h3 {
            font-size: 12px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }
        .features ul {
            list-style: none;
        }
        .features li {
            padding: 4px 0;
            font-size: 13px;
            color: #555;
        }
        .features li:before {
            content: "✓ ";
            color: #48bb78;
            font-weight: bold;
            margin-right: 5px;
        }
    </style>
</head>
<body>
    <div class="container">
        <span class="badge">Production Ready</span>
        <h1>{{.Title}}</h1>
        <p class="subtitle">Showcasing production deployment features</p>

        <div class="features">
            <h3>Enabled Features</h3>
            <ul>
                <li>Environment-based configuration</li>
                <li>Structured JSON logging</li>
                <li>Request tracing with trace IDs</li>
                <li>Graceful shutdown</li>
                <li>Health & readiness checks</li>
                <li>Metrics endpoint</li>
            </ul>
        </div>

        <div class="counter-display">
            <div class="counter-value">{{.Counter}}</div>
            <div class="counter-label">Counter Value</div>
        </div>

        <div class="button-group">
            <button lvt-click="increment">+1</button>
            <button lvt-click="decrement">-1</button>
            <button class="reset" lvt-click="reset">Reset</button>
        </div>

        <div class="footer">
            Last updated: {{.LastUpdated}}
        </div>
    </div>

    {{if .lvt.DevMode}}
    <script src="/livetemplate-client.js"></script>
    {{else}}
    <script src="https://cdn.jsdelivr.net/npm/@livetemplate/client@latest/dist/livetemplate-client.browser.js"></script>
    {{end}}
</body>
</html>
